# Copy to simulator/.env for running the simulator on the host (not Docker).
# DEV ONLY placeholders — not real secrets.

NODE_ENV=development
PORT=4100

# Separate simulator database. Never point this at billinghub.
DATABASE_URL=postgres://billing:billing_dev_password@localhost:5432/billinghub_sim
TEST_DATABASE_URL=postgres://billing:billing_dev_password@localhost:5432/billinghub_sim_test

BACKEND_WEBHOOK_URL=http://localhost:4000/webhooks/payments
# DEV ONLY — placeholder, not a real secret. Replace before any non-local use.
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret-change-me
# Backend-only; documented here so every .env.example lists the Step 8 setting.
WEBHOOK_JOB_RETRY_LIMIT=5
SIMULATOR_API_KEY=dev-only-simulator-api-key
SIMULATOR_CONTROL_TOKEN=dev-only-simulator-control
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_MS=1000
WEBHOOK_TIMEOUT_MS=5000
