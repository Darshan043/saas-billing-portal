generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  SUCCEEDED
  DECLINED
  INSUFFICIENT_FUNDS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

enum DeliveryStatus {
  SUCCESS
  FAILED
  FORCED_FAIL
}

enum DeliveryReason {
  INITIAL
  RETRY
  REPLAY
  DUPLICATE
}

enum TokenKind {
  VISA_OK
  DECLINED
  INSUFFICIENT_FUNDS
}

enum BillingInterval {
  MONTH
  YEAR
}

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  name            String
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  paymentMethods PaymentMethod[]
  payments       Payment[]
  subscriptions  Subscription[]
  invoices       Invoice[]

  @@map("sim_customers")
}

model PaymentMethod {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  // Test-only kind. Never a real PAN/CVV.
  tokenKind  TokenKind @map("token_kind")
  label      String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([customerId])
  @@map("sim_payment_methods")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  paymentMethodId  String?       @map("payment_method_id") @db.Uuid
  amount           Int
  currency         String
  status           PaymentStatus
  errorCode        String?       @map("error_code")
  idempotencyKey   String?       @unique @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  invoice       Invoice?

  @@index([createdAt])
  @@index([customerId])
  @@map("sim_payments")
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  customerId  String             @map("customer_id") @db.Uuid
  status      SubscriptionStatus
  amount      Int
  currency    String
  planPriceId String?            @map("plan_price_id")
  interval    BillingInterval?
  metadata    Json?
  canceledAt  DateTime?          @map("canceled_at") @db.Timestamptz
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([customerId])
  @@index([createdAt])
  @@map("sim_subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  paymentId      String?       @unique @map("payment_id") @db.Uuid
  amount         Int
  currency       String
  status         InvoiceStatus
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("sim_invoices")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  type        String
  objectId    String        @map("object_id")
  payload     Json
  rawBody     String        @map("raw_body") @db.Text
  status      WebhookStatus @default(PENDING)
  attempts    Int           @default(0)
  nextRetryAt DateTime?     @map("next_retry_at") @db.Timestamptz
  lastError   String?       @map("last_error") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  deliveries WebhookDelivery[]

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("sim_webhook_events")
}

model WebhookDelivery {
  id           String         @id @default(uuid()) @db.Uuid
  eventId      String         @map("event_id") @db.Uuid
  attemptNumber Int           @map("attempt_number")
  status       DeliveryStatus
  reason       DeliveryReason
  httpStatus   Int?           @map("http_status")
  responseBody String?        @map("response_body") @db.Text
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  event WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@map("sim_webhook_deliveries")
}

model Settings {
  id       Int     @id
  failNext Boolean @default(false) @map("fail_next")

  @@map("sim_settings")
}
