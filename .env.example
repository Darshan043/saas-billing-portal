# Copy this file to .env in the project root before running Docker Compose.
# This file is safe to commit. Never commit a real .env.

# --- Postgres ---
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing_dev_password
POSTGRES_DB=billinghub
POSTGRES_PORT=5432

# --- Published host ports ---
FRONTEND_PORT=5173
BACKEND_PORT=4000
SIMULATOR_PORT=4100
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Shared app settings ---
NODE_ENV=development

# Used by the backend inside Docker (hostname "postgres" is the Compose service).
DATABASE_URL=postgres://billing:billing_dev_password@postgres:5432/billinghub

FRONTEND_ORIGIN=http://localhost:5173
SIMULATOR_URL=http://simulator:4100

# DEV ONLY placeholders — not real secrets. Used by the simulator HTTP API
# and dashboard manual controls. Replace before any non-local use.
SIMULATOR_API_KEY=dev-only-simulator-api-key
SIMULATOR_CONTROL_TOKEN=dev-only-simulator-control

# Simulator persistence (separate Postgres database on the same server).
# Inside Docker the hostname is "postgres". Do not point this at billinghub.
SIMULATOR_DATABASE_URL=postgres://billing:billing_dev_password@postgres:5432/billinghub_sim
SIMULATOR_TEST_DATABASE_URL=postgres://billing:billing_dev_password@postgres:5432/billinghub_sim_test

# --- SMTP / Brevo Email Delivery ---
# In Docker Compose, Mailpit runs on mailpit:1025. In production on Render, configure Brevo SMTP:
# Host: smtp-relay.brevo.com, Port: 587, Secure: false (STARTTLS)
ENABLE_EMAIL_DELIVERY=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BillingHub

# DEV ONLY — placeholder, not a real secret. Replace before any non-local use.
# Must be identical for backend and simulator.
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret-change-me
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_JOB_RETRY_LIMIT=5
SUBSCRIPTION_PENDING_TIMEOUT_MINUTES=15

# Simulator -> backend webhook (path is created in a later step).
BACKEND_WEBHOOK_URL=http://backend:4000/webhooks/payments

# Browser talks to the backend via the host-mapped port, not the Docker hostname.
VITE_API_URL=http://localhost:4000

# DEV ONLY — seed admin for local development. Never use in production.
SEED_ADMIN_EMAIL=admin@billinghub.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# DEV ONLY — JWT signing secret. Must be at least 32 characters. Replace before any non-local use.
JWT_SECRET=dev-only-jwt-secret-change-me-32chars-min
JWT_EXPIRES_IN=7d
COOKIE_NAME=billing_token

# Used only by backend tests. Never point this at the development database.
TEST_DATABASE_URL=postgres://billing:billing_dev_password@postgres:5432/billinghub_test
