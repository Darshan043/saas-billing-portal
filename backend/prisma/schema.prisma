generator client {
  provider      = "prisma-client-js"
  // native = host OS; linux-musl-openssl-3.0.x = node:20-alpine in Docker
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  REJECTED
}

enum AuditSource {
  CUSTOMER
  ADMIN
  WEBHOOK
  JOB
  SYSTEM
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum ReconciliationScope {
  ALL
  SINGLE
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReconciliationResolution {
  OPEN
  FIXED
  REVIEWED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  // Always persist lowercase; uniqueness is on the stored value.
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships        Membership[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  reconciliationRuns ReconciliationRun[]
  resolvedItems      ReconciliationItem[] @relation("ResolvedBy")

  @@index([role])
  @@map("users")
}

model Organization {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  billingEmail       String   @map("billing_email")
  providerCustomerId String?  @unique @map("provider_customer_id")
  nextInvoiceNumber  Int      @default(1) @map("next_invoice_number")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships         Membership[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  payments            Payment[]
  usageCounters       UsageCounter[]
  auditLogs           AuditLog[]
  emailLogs           EmailLog[]
  reconciliationItems ReconciliationItem[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  // Unique on userId: this version allows ONE organization per user.
  // Relax later by dropping this unique and keeping @@unique([userId, organizationId]).
  userId         String         @unique @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String
  features    Json
  usageLimit  Int      @map("usage_limit")
  usageMetric String   @default("api_calls") @map("usage_metric")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  prices PlanPrice[]

  @@index([isActive])
  @@map("plans")
}

model PlanPrice {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  interval        BillingInterval
  amount          Int
  currency        String          @default("USD")
  providerPriceId String?         @map("provider_price_id")
  isActive        Boolean         @default(true) @map("is_active")
  retiredAt       DateTime?       @map("retired_at") @db.Timestamptz
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  plan                 Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions        Subscription[] @relation("SubscriptionPrice")
  pendingSubscriptions Subscription[] @relation("PendingPlanPrice")

  // One active price per (planId, interval) is a partial unique index in the init migration.
  @@index([planId])
  @@index([isActive])
  @@map("plan_prices")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  planPriceId            String             @map("plan_price_id") @db.Uuid
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  pendingPlanPriceId     String?            @map("pending_plan_price_id") @db.Uuid
  pausedAt               DateTime?          @map("paused_at") @db.Timestamptz
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz
  endedAt                DateTime?          @map("ended_at") @db.Timestamptz
  retryCount             Int                @default(0) @map("retry_count")
  nextRetryAt            DateTime?          @map("next_retry_at") @db.Timestamptz
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planPrice        PlanPrice     @relation("SubscriptionPrice", fields: [planPriceId], references: [id], onDelete: Restrict)
  pendingPlanPrice PlanPrice?    @relation("PendingPlanPrice", fields: [pendingPlanPriceId], references: [id], onDelete: Restrict)
  invoices         Invoice[]
  payments         Payment[]
  auditLogs        AuditLog[]
  reconciliationRuns  ReconciliationRun[]
  reconciliationItems ReconciliationItem[]

  // One non-canceled subscription per organization is a partial unique index in the init migration.
  @@index([organizationId])
  @@index([planPriceId])
  @@index([pendingPlanPriceId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([nextRetryAt])
  @@map("subscriptions")
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  number            Int
  status            InvoiceStatus
  subtotal          Int
  total             Int
  currency          String        @default("USD")
  periodStart       DateTime      @map("period_start") @db.Timestamptz
  periodEnd         DateTime?     @map("period_end") @db.Timestamptz
  issuedAt          DateTime      @map("issued_at") @db.Timestamptz
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  providerInvoiceId String?       @unique @map("provider_invoice_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Int      @default(1)
  unitAmount  Int      @map("unit_amount")
  amount      Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  invoiceId          String?       @map("invoice_id") @db.Uuid
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  providerPaymentId  String        @unique @map("provider_payment_id")
  status             PaymentStatus
  amount             Int
  currency           String        @default("USD")
  failureCode        String?       @map("failure_code")
  failureMessage     String?       @map("failure_message")
  paymentMethodLabel String?       @map("payment_method_label")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model UsageCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  metric         String
  periodStart    DateTime @map("period_start") @db.Timestamptz
  periodEnd      DateTime @map("period_end") @db.Timestamptz
  count          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, periodStart])
  @@map("usage_counters")
}

model WebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  // Nullable: invalid signatures have no trustworthy provider id. Postgres unique allows many NULLs.
  providerEventId String?            @unique @map("provider_event_id")
  type            String
  payload         Json
  rawBody         String?            @map("raw_body") @db.Text
  signatureValid  Boolean            @map("signature_valid")
  status          WebhookEventStatus
  duplicateCount  Int                @default(0) @map("duplicate_count")
  attempts        Int                @default(0)
  lastError       String?            @map("last_error") @db.Text
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz

  auditLogs AuditLog[]

  @@index([status])
  @@index([type])
  @@index([receivedAt])
  @@map("webhook_events")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  subscriptionId String?     @map("subscription_id") @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  action         String
  beforeState    Json?       @map("before_state")
  afterState     Json?       @map("after_state")
  source         AuditSource
  actorUserId    String?     @map("actor_user_id") @db.Uuid
  webhookEventId String?     @map("webhook_event_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@index([organizationId])
  @@index([actorUserId])
  @@index([webhookEventId])
  @@map("audit_logs")
}

model EmailLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  recipient      String
  template       String
  dedupeKey      String      @unique @map("dedupe_key")
  status         EmailStatus
  error          String?
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status])
  @@map("email_logs")
}

model ReconciliationRun {
  id              String                  @id @default(uuid()) @db.Uuid
  startedByUserId String?                 @map("started_by_user_id") @db.Uuid
  scope           ReconciliationScope
  subscriptionId  String?                 @map("subscription_id") @db.Uuid
  status          ReconciliationRunStatus
  checkedCount    Int                     @default(0) @map("checked_count")
  mismatchCount   Int                     @default(0) @map("mismatch_count")
  startedAt       DateTime                @default(now()) @map("started_at") @db.Timestamptz
  completedAt     DateTime?               @map("completed_at") @db.Timestamptz

  startedBy    User?                 @relation(fields: [startedByUserId], references: [id], onDelete: Restrict)
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  items        ReconciliationItem[]

  @@index([startedByUserId])
  @@index([subscriptionId])
  @@index([status])
  @@map("reconciliation_runs")
}

model ReconciliationItem {
  id               String                   @id @default(uuid()) @db.Uuid
  runId            String                   @map("run_id") @db.Uuid
  subscriptionId   String?                  @map("subscription_id") @db.Uuid
  organizationId   String?                  @map("organization_id") @db.Uuid
  field            String
  localValue       String?                  @map("local_value")
  providerValue    String?                  @map("provider_value")
  severity         ReconciliationSeverity
  resolution       ReconciliationResolution @default(OPEN)
  suggestedFix     String?                  @map("suggested_fix")
  resolvedAt       DateTime?                @map("resolved_at") @db.Timestamptz
  resolvedByUserId String?                  @map("resolved_by_user_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  run          ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resolvedBy   User?             @relation("ResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([subscriptionId])
  @@index([organizationId])
  @@index([resolvedByUserId])
  @@index([resolution])
  @@map("reconciliation_items")
}
