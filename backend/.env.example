# Copy to backend/.env for running the API on the host (not Docker).
# DEV ONLY placeholders — not real secrets.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://billing:billing_dev_password@localhost:5432/billinghub
FRONTEND_ORIGIN=http://localhost:5173
SIMULATOR_URL=http://localhost:4100
# DEV ONLY — shared with the simulator. Replace before any non-local use.
SIMULATOR_API_KEY=dev-only-simulator-api-key
SIMULATOR_TIMEOUT_MS=5000
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
# DEV ONLY — placeholder, not a real secret. Replace before any non-local use.
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret-change-me

# DEV ONLY — seed admin for local development. Never use in production.
SEED_ADMIN_EMAIL=admin@billinghub.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# DEV ONLY — JWT signing secret. Must be at least 32 characters. Replace before any non-local use.
JWT_SECRET=dev-only-jwt-secret-change-me-32chars-min
JWT_EXPIRES_IN=7d
COOKIE_NAME=billing_token

# Used only by backend tests. Host port may differ if 5432 is already taken.
TEST_DATABASE_URL=postgres://billing:billing_dev_password@localhost:5432/billinghub_test
